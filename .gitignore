# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test / lint artifacts
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Private per-peer config (never shared, may contain identifying info/credentials)
config/police/game.toml
config/police/*.local.toml

# Secrets / credentials
.env
# The Gmail OAuth pair, by the exact names Appendix A tells you to download.
# `*.credentials.json` does NOT match a bare `credentials.json` -- the glob needs
# something before the dot -- so the literal name has to be listed as well.
credentials.json
token.json
*.credentials.json
*token*.json

# OS / editor
.DS_Store

# Team-sync bookkeeping state (internal, not a counted game record)
logs/*/team_sync/

# Generated match output: exported GIF/MP4 and the report artifacts, all
# reproducible from a run (--export / --report). Kept local like logs/.
results/

# Course spec/guidelines PDFs and their extracted text - copyrighted material, kept local-only
police_thief_p2p.pdf
guidelines.pdf
output.md

# Agent worktrees created during multi-agent development sessions
.claude/worktrees/

# Personal course notes, kept local-only
hw.md

# Grading feedback, kept local-only
Detailed_Feedback_Report_384596.pdf
report.md

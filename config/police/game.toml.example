version = "1.10"

[game]
group_id = "MOAAMOHA"
sub_game_number = 6
members = ["id-1001", "id-1002"]
repos = { cop = "https://github.com/you/repo", thief = "https://github.com/you/repo" }

[network]
my_port         = 8801                             # MY MCP server port
opponent_url    = "http://127.0.0.1:8802/mcp"       # the only thing I know about the opponent

# MY reserved ngrok domain, used by `police-agent --tunnel` (Appendix He rule 10:
# a league match needs a public URL, because both peers sit behind NAT). Private
# per-peer setting, NOT an agreed term -- it never belongs in game.json.
# Reserve one at https://dashboard.ngrok.com/domains; without it ngrok hands out a
# new random URL on every restart, and the opposing team has the old one in their
# own opponent_url.
# tunnel_domain = "your-reserved-name.ngrok-free.app"
#
# The ngrok authtoken is NOT configured here and must never be. Run this once, in
# your own terminal, and ngrok keeps it in ~/.config/ngrok/ngrok.yml:
#   ngrok config add-authtoken <your token>

# [strategy]  -- optional: point at YOUR brain subclass (else the shipped heuristic runs)
# police_class = "my_team.strategy:MyPoliceBrain"

# [belief]  -- optional: how far a scent reading outweighs the prior. Private tuning,
# NOT an agreed term: the scent constants themselves are signed and live in game.json.
# smell_trust = 4.0
#
# smell_power shapes HOW a reading's intensity converts to trust. Each cell is
# first normalised against the strongest cell in THAT reading (reading =
# scent / peak), then boosted by 1 + smell_trust * reading**smell_power -- so
# above 1, a cell that is faint relative to this reading's own peak is starved
# harder than the peak itself, regardless of the packet's absolute scale.
# smell_power = 3.0
#
# leak re-mixes a small fraction of the posterior back toward the flat prior
# every observation, so a cell that stops being reinforced doesn't stay
# overweighted forever.
# leak = 0.03
#
# stale_decay adds an EXTRA multiplicative shrink, on top of leak, to any cell
# whose reading this turn (same peak-relative quantity smell_power shapes)
# fell below stale_support -- i.e. one that isn't currently being reinforced.
# Compounds turn over turn for a cell abandoned several turns running. 1.0
# disables it (today's flat-leak-only behaviour); lower is more aggressive.
# stale_decay = 0.85
# stale_support = 0.1

# [reliability] -- private, per-peer liveness watchdog (spec ch. 8.4), NOT an
# agreed term: it bounds only how long THIS peer's own turn loop may go
# without completing a turn, independent of any single network call's own
# timeout. Not the same thing as network.watchdog_timeout_sec (a shared,
# per-call deadline) -- do not confuse the two.
# loop_watchdog_timeout_seconds = 180.0

# HOW the banter is produced. The MOVE is always pure Python: a language model
# shapes text and nothing else (Appendix He 25, ch. 6.5). The shipped default is
# a local Ollama model -- free, offline, no token budget. Needs `ollama serve`
# running and `ollama pull qwen3:4b` done once; if it is not there, every turn
# falls back to a canned line and the match plays on regardless.
[trash_talk]
provider = "ollama"            # ollama (default) | template (canned, no model)
model = "qwen3:4b"             # any model you have pulled locally
ollama_url = "http://localhost:11434/api/generate"
timeout_seconds = 5.0          # a taunt must never eat into the turn budget
every_n_steps = 1              # raise it to call the model less often on a slow box

# [bluff] -- how hard a hint may pull the belief map once the thief has proved
# itself honest (or been caught lying). The reading itself is always on: the same
# [trash_talk] model reads the thief's hints, and without one they are read by
# keyword instead. Nothing here is an agreed term.
# gain = 0.6

# [gui] -- how the window paces itself. Purely local presentation: it slows the
# board down so a human can follow it, and slows nothing the opponent can see.
# Leave it at 0 for a league match -- the thief's watchdog is still running.
[gui]
step_seconds = 0.0             # pause after each of my moves; replay defaults to 0.5

[llm]
model = "claude-opus-4-8[1m]"    # MY choice; the opponent may differ
step_deadline_seconds = 30       # hard cap on LLM thinking per step

# The mandatory end-of-game report (Appendix He rules 30/32/34/35, ch. 9.3.3).
# The result artifact is mailed to the lecturer as a JSON ATTACHMENT; the body
# never carries game data, because a free-text report is rejected (rule 34).
# Private per-peer settings: the recipient, the paths and the daily cap are mine
# alone and never belong in the signed game.json.
[email]
enabled = false                        # a real API call is opt-in, always
recipient = "rmisegal+uoh26finalgame@gmail.com"
# draft = write a local .eml file and call nobody | send = the Gmail API.
# "draft" is NOT a Gmail draft: creating one needs the gmail.compose scope, and
# rule 30 fixes this agent's scope at gmail.send, which cannot.
mode = "draft"
credentials_file = "credentials.json"  # downloaded per Appendix Alef; gitignored
token_file = "token.json"              # written by the one-time consent flow; gitignored
daily_limit = 20                       # ch. 9.3.1's first gate, ahead of the token bucket
quota_file = "logs/.mail_quota.json"   # where that daily count is remembered across runs

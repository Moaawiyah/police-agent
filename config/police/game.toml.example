version = "1.10"

[game]
group_id = "police-team"
sub_game_number = 1
members = ["id-1001", "id-1002"]
repos = { cop = "https://github.com/you/repo", thief = "https://github.com/you/repo" }

[network]
my_port         = 8801                             # MY MCP server port
opponent_url    = "http://127.0.0.1:8802/mcp"       # the only thing I know about the opponent
turn_timeout_seconds = 180

# [strategy]  -- optional: point at YOUR brain subclass (else the shipped heuristic runs)
# police_class = "my_team.strategy:MyPoliceBrain"

# [belief]  -- optional: how far a scent reading outweighs the prior. Private tuning,
# NOT an agreed term: the scent constants themselves are signed and live in game.json.
# smell_trust = 4.0

# HOW the banter is produced. The MOVE is always pure Python: a language model
# shapes text and nothing else (Appendix He 25, ch. 6.5). The shipped default is
# a local Ollama model -- free, offline, no token budget. Needs `ollama serve`
# running and `ollama pull qwen3:4b` done once; if it is not there, every turn
# falls back to a canned line and the match plays on regardless.
[trash_talk]
provider = "ollama"            # ollama (default) | template (canned, no model)
model = "qwen3:4b"             # any model you have pulled locally
ollama_url = "http://localhost:11434/api/generate"
timeout_seconds = 5.0          # a taunt must never eat into the turn budget
every_n_steps = 1              # raise it to call the model less often on a slow box

# [bluff] -- how hard a hint may pull the belief map once the thief has proved
# itself honest (or been caught lying). The reading itself is always on: the same
# [trash_talk] model reads the thief's hints, and without one they are read by
# keyword instead. Nothing here is an agreed term.
# gain = 0.6

# [gui] -- how the window paces itself. Purely local presentation: it slows the
# board down so a human can follow it, and slows nothing the opponent can see.
# Leave it at 0 for a league match -- the thief's watchdog is still running.
[gui]
step_seconds = 0.0             # pause after each of my moves; replay defaults to 0.5

[llm]
model = "claude-opus-4-8[1m]"    # MY choice; the opponent may differ
step_deadline_seconds = 30       # hard cap on LLM thinking per step

[email]
recipient = "rmisegal+uoh26finalgame@gmail.com"
mode = "draft"
